PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/stylekart
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# In production, list every allowed browser origin separated by commas.
CORS_ORIGINS=http://localhost:5173
# Use "none" only for a cross-site production frontend/backend deployment over HTTPS.
COOKIE_SAME_SITE=lax
# Set true only when the deployed app is behind one trusted reverse proxy.
TRUST_PROXY=false
